{
  "name": "swifty-starrail",
  "version": "0.0.1",
  "description": "star rail toolbox",
  "main": "./out/main/index.js",
  "author": "https://github.com/hangtiancheng",
  "homepage": "https://github.com/hangtiancheng/swifty-starrail",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/swifty-starrail"
  },
  "scripts": {
    "format": "prettier -w . --experimental-cli",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps || node ./scripts/fix.mjs",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "release:win": "node scripts/release.mjs win",
    "release:mac": "node scripts/release.mjs mac",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@swifty.js/sentry": "latest",
    "@tanstack/react-virtual": "^3.14.2",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react-router": "^7.16.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "optionalDependencies": {
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  }
}
